# --- Base de données -------------------------------------------------------
# Local :
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comanet_os
DATABASE_SSL=false
# Supabase (Project Settings → Database → Connection string) :
#   - application / Vercel : « Transaction pooler » (port 6543)
#     DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
#   - scripts en ligne de commande (db:push, db:import) : « Session pooler » (port 5432)
#   DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# --- Sessions --------------------------------------------------------------
# Chaîne aléatoire longue (ex. : openssl rand -base64 48)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Installation en ligne (/installation) ----------------------------------
# Clé (8+ caractères) demandée par la page /installation pour créer le schéma, le socle et charger le classeur.
# SETUP_KEY=

# --- Divers ----------------------------------------------------------------
# BUSINESS_TZ=Africa/Casablanca

# --- Régie Meta (lecture seule) ---------------------------------------------
# Jeton d'utilisateur système (Business Manager → Paramètres → Utilisateurs système),
# permission `ads_read` UNIQUEMENT. Un jeton d'utilisateur système n'expire pas, mais il ne
# couvre que les comptes du business qui l'a émis : les comptes COMANET sont répartis sur
# plusieurs businesses, prévoir un jeton par business si nécessaire.
# META_ACCESS_TOKEN=
# Version de l'API épinglée (défaut : v23.0). À changer explicitement, jamais par surprise.
# META_API_VERSION=v23.0
# Secret du cron Vercel : sans lui, /api/cron/meta refuse tout appel.
# CRON_SECRET=

# --- Copilote IA (Anthropic) ------------------------------------------------
# Sans clé, l'application fonctionne normalement et le copilote affiche « non configuré ».
# ANTHROPIC_API_KEY=
# Modèle rapide (explications de cartes, brief du matin) et modèle avancé (questions libres, plans, rapports).
# AI_MODEL_FAST=claude-sonnet-5
# AI_MODEL_ADVANCED=claude-opus-5
