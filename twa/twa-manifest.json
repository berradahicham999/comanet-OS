{
  "packageId": "ma.comanet.os",
  "host": "comanet-os.vercel.app",
  "name": "COMANET OS",
  "launcherName": "COMANET",
  "display": "standalone",
  "orientation": "portrait",
  "themeColor": "#0f766e",
  "themeColorDark": "#0f766e",
  "navigationColor": "#ffffff",
  "navigationColorDark": "#ffffff",
  "navigationDividerColor": "#e5e5e0",
  "navigationDividerColorDark": "#e5e5e0",
  "backgroundColor": "#f5f5f3",
  "enableNotifications": true,
  "startUrl": "/m",
