  "maskableIconUrl": "https://comanet-os.vercel.app/icons/icon-maskable-512.png",
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "webManifestUrl": "https://comanet-os.vercel.app/manifest.webmanifest",
  "fallbackType": "customtabs",
