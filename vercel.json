{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/meta?mode=intraday",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/meta?mode=full",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/analytics",
      "schedule": "30 6 * * *"
    }
  ]
}
